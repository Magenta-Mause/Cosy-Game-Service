# Cosy Game Service — environment configuration
# Copy this file to `docker/.env` and fill in your own values. Do NOT commit it.
#
# Docker Compose reads `.env` from next to the compose file (docker/), so that
# is the only location it is picked up from. The binary itself does not load
# `.env` (no dotenv/dotenvy dependency) — for `cargo run`, export the variable
# instead, or `set -a; source docker/.env; set +a` first.

# Your SteamGridDB API key (required).
# Create an account and generate a key at https://www.steamgriddb.com/
# It is sent as a Bearer token to the upstream SteamGridDB API, and the
# service will refuse to start if this variable is not set.
COSY_GAMEAPI_SGDB_API_KEY=
